{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/pkirsanov/bubbles/schemas/execution-control-event.schema.json",
  "title": "Bubbles execution-control event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractType",
    "schemaVersion",
    "sequence",
    "eventType",
    "eventId",
    "previousEventDigest",
    "eventDigest",
    "recordedAt",
    "occurrenceId",
    "attemptId",
    "posture",
    "subject",
    "objectDigest",
    "supersedesEventId",
    "extensions"
  ],
  "properties": {
    "contractType": { "const": "execution-control-event" },
    "schemaVersion": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "eventType": { "enum": ["RECORD", "CORRECT", "SUPERSEDE"] },
    "eventId": { "type": "string", "minLength": 1 },
    "previousEventDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "eventDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "occurrenceId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": ["string", "null"], "minLength": 1 },
    "posture": { "enum": ["off", "shadow", "reference-enforce", "unsupported"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "objectDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "supersedesEventId": { "type": ["string", "null"], "minLength": 1 },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "schemaVersion", "payloadDigest"],
        "properties": {
          "namespace": { "type": "string", "minLength": 1 },
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "payloadDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  }
}
