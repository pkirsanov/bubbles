{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/pkirsanov/bubbles/schemas/workflows.schema.json",
  "title": "Bubbles workflow registry",
  "type": "object",
  "required": ["defaultMode", "gates"],
  "additionalProperties": true,
  "properties": {
    "defaultMode": { "type": "string" },
    "gates": {
      "type": "object",
      "patternProperties": {
        "^G[0-9]{3}$": {
          "type": "object",
          "required": ["name", "description"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_gate$"
            },
            "description": {
              "type": "string",
              "minLength": 10
            },
            "enforcedBy": {
              "description": "IMP-027 SCOPE-2a. Declares the surface(s) that actually enforce this gate, so docs/generated/gate-coverage-map.md is derived from a declaration instead of inferred by grepping gate IDs out of scripts. 'mode-required' means a mode demands the gate but no dedicated mechanical enforcer implements it; 'unbound' means no enforcement surface exists and is deliberately left visible rather than hidden behind a plausible-looking binding.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(guard-check:[0-9]+[A-Za-z]?|script:[A-Za-z0-9_./-]+\\.sh|ci:[A-Za-z0-9_.-]+|mode-required|behavioral:bubbles\\.[a-z-]+|unbound)$"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "modes": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "description": { "type": "string" },
            "phases": {
              "type": "array",
              "items": { "type": "string" }
            },
            "requiredGates": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^G[0-9]{3}$"
              }
            },
            "statusCeiling": { "type": "string" },
            "transitionAudit": {
              "type": "object",
              "required": ["profile", "target"],
              "additionalProperties": false,
              "properties": {
                "profile": {
                  "enum": [
                    "planning-maturity-v1",
                    "delivery-completion-v1",
                    "delivery-completion-fast-v1"
                  ]
                },
                "target": { "const": "statusCeiling" }
              }
            },
            "terminalAliases": {
              "type": "array",
              "items": { "type": "string" }
            },
            "inherits": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ]
            }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
